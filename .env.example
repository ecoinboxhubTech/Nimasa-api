# Copy to .env and fill in. Names and placeholders only: never commit real secrets (NFR-005).

# --- App ---
APP_ENV=development                 # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173  # comma-separated list of front-end origins

# --- Database (PostgreSQL only: Aiven for local and production) ---
# Copy the "Service URI" from your Aiven service's Overview page and paste it as-is. It looks like
#   postgres://avnadmin:<password>@<service>-<project>.aivencloud.com:<port>/<database>?sslmode=require
# (the postgres:// prefix is converted automatically; keep ?sslmode=require so the connection is encrypted).
# Use a different database name per environment: blueintel_dev locally, blueintel_prod in production.
# Optional stricter TLS: download Aiven's CA certificate and append  &sslrootcert=/path/to/ca.pem  with sslmode=verify-full.
DATABASE_URL=
# Used only by pytest. Must be a SEPARATE database whose name ends in _test: every test run DROPS its tables.
TEST_DATABASE_URL=

# --- Admin access (protects /api/v1/admin/*). The public needs no login. ---
# Staff sign in with email + password (POST /api/v1/admin/auth/login). The first administrator is created on startup
# from these two values when no administrators exist; remove them afterwards and manage staff through the API.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=           # at least 12 characters
ADMIN_SESSION_HOURS=8
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Optional service key for automation/scripts (cannot manage staff). Leave empty to disable.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Data ingestion ---
# demo        = synthetic sample data (default; no external calls)
# open_meteo  = Open-Meteo marine + weather API (CANDIDATE source, see README: licence review required)
# meteosource = Meteosource weather API (CANDIDATE source; needs METEOSOURCE_API_KEY and licence review; wind speed only)
ACTIVE_SOURCE=demo
# Set to true only AFTER the licence, attribution and commercial-use terms of a real source were reviewed.
SOURCE_LICENCE_REVIEWED=false
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=60
INGEST_MAX_RETRIES=3
INGEST_BACKOFF_SECONDS=2
INGEST_TIMEOUT_SECONDS=20
RETENTION_DAYS=90
# Demo only: make the sample feed N hours old to test stale-data behaviour
DEMO_LAG_HOURS=0

# Meteosource (backend only: never expose the key to the front-end). Tier = the endpoint tier of your plan.
METEOSOURCE_API_KEY=
METEOSOURCE_TIER=free

# --- AI insights (Groq) ---
AI_ENABLED=true
GROQ_API_KEY=                       # from https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile  # check Groq's current model list
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20

# --- Rate limits (per client IP, per minute) ---
RATE_LIMIT_PER_MINUTE=30
INSIGHTS_RATE_LIMIT_PER_MINUTE=6

# --- Staff accounts, MFA and password reset ---
# First-run bootstrap role: admin | operator | viewer. Admins manage staff; operators can edit feeds/content; viewers read only.
ADMIN_BOOTSTRAP_ROLE=admin
# Public origin used in password-reset links.
PUBLIC_BASE_URL=http://localhost:5173
PASSWORD_RESET_HOURS=1

# --- Developer sandbox / API keys ---
DEVELOPER_KEY_QUOTA_PER_DAY=1000
DEVELOPER_KEY_RATE_PER_MINUTE=60
DEVELOPER_KEYS_PER_HOUR=5

# --- Durable jobs ---
JOBS_ENABLED=true
JOB_POLL_SECONDS=30

# --- Notifications (email/webhook/SMS outbox) ---
NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@orizon-nimasa.local
SMTP_USE_TLS=true
WEBHOOK_TIMEOUT_SECONDS=10
# SMS/webhook delivery uses a target address configured in the admin console. Real gateway credentials are not bundled.

# --- Marine providers (provider-ready adapters; demo data is synthetic) ---
AIS_PROVIDER=demo
BATHYMETRY_PROVIDER=demo
TIDE_PROVIDER=harmonic-demo
# Real AIS/bathymetry/tide provider credentials are not included. Keep demo ids until a licensed feed is approved.
